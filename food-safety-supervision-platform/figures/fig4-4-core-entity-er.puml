' 图4-4 核心业务实体ER图
' 用途：展示系统核心实体及主要关系，聚焦「企业纳管—监管执行—问题整改—公众监督—风险预警」主链路
' 说明：跨微服务库表之间为逻辑关联（应用层维护），图中以虚线标注；stereotype 为物理表名，便于对照各服务 schema
@startuml
hide circle
skinparam linetype ortho

entity "系统用户" as sys_user <<sys_user>> {
  *id : 主键
  --
  username : 用户名
  user_type : 用户类型
  status : 账号状态
}

entity "系统角色" as sys_role <<sys_role>> {
  *id : 主键
  --
  role_code : 角色编码
  role_name : 角色名称
}

entity "用户角色关联" as sys_user_role <<sys_user_role>> {
  *id : 主键
  --
  user_id : 用户ID
  role_id : 角色ID
}

entity "行政区划" as addr_region <<addr_region>> {
  *id : 主键
  --
  parent_id : 上级区域ID
  name : 区域名称
  level : 区域级别
}

entity "食品企业" as food_enterprise <<food_enterprise>> {
  *id : 主键
  --
  user_id : 企业账号用户ID
  enterprise_name : 企业名称
  approval_status : 审核状态
  region_id : 所属行政区ID
  status : 监管状态
}

entity "企业备案附件" as enterprise_profile_attachment <<enterprise_profile_attachment>> {
  *id : 主键
  --
  enterprise_id : 企业ID
  attachment_type : 附件类型
  attachment_url : 附件地址
}

entity "企业产品档案" as food_product <<food_product>> {
  *id : 主键
  --
  enterprise_id : 企业ID
  product_name : 产品名称
  status : 产品状态
}

entity "监管人员档案" as food_regulator <<food_regulator>> {
  *id : 主键
  --
  user_id : 监管账号用户ID
  name : 姓名
  role_type : 监管角色类型
  status : 在岗状态
}

entity "监管人员辖区" as food_regulator_region <<food_regulator_region>> {
  *id : 主键
  --
  regulator_id : 监管人员ID
  region_id : 辖区ID
}

entity "检查任务" as inspection_task <<inspection_task>> {
  *id : 主键
  --
  enterprise_id : 企业ID
  region_id : 所属行政区ID
  assigned_to : 指派执法员ID
  status : 任务状态
}

entity "监督检查记录" as inspection_record <<inspection_record>> {
  *id : 主键
  --
  task_id : 检查任务ID
  enterprise_id : 企业ID
  inspector_id : 检查人员ID
  result : 检查结果
}

entity "检查明细" as inspection_item <<inspection_item>> {
  *id : 主键
  --
  inspection_id : 检查记录ID
  item_name : 检查项名称
  item_result : 检查项结果
}

entity "整改任务" as rectification_task <<rectification_task>> {
  *id : 主键
  --
  inspection_id : 检查记录ID
  enterprise_id : 企业ID
  status : 整改状态
}

entity "抽检任务" as sampling_task <<sampling_task>> {
  *id : 主键
  --
  enterprise_id : 企业ID
  product_id : 产品ID
  assigned_to : 指派执法员ID
  status : 任务状态
}

entity "抽检结果" as sampling_result <<sampling_result>> {
  *id : 主键
  --
  task_id : 抽检任务ID
  result : 抽检结论
  public_status : 公示状态
}

entity "公众投诉" as complaint <<complaint>> {
  *id : 主键
  --
  submitter_user_id : 提交用户ID
  enterprise_id : 被投诉企业ID
  assigned_to : 指派处理人ID
  status : 投诉状态
}

entity "投诉处理记录" as complaint_handle <<complaint_handle>> {
  *id : 主键
  --
  complaint_id : 投诉ID
  handler_id : 处理人ID
  handle_result : 处理结果
}

entity "预警记录" as warning_record <<warning_record>> {
  *id : 主键
  --
  warning_type : 预警类型
  biz_type : 业务类型
  biz_id : 业务ID
  region_id : 辖区ID
  level : 预警档位
  status : 预警状态
}

entity "预警处理日志" as warning_process_log <<warning_process_log>> {
  *id : 主键
  --
  warning_id : 预警ID
  action_type : 动作类型
}

entity "公众公告" as public_bulletin <<public_bulletin>> {
  *id : 主键
  --
  title : 公告标题
  category : 公告类别
  status : 发布状态
}

' ---------- 同库 / 主数据关系 ----------
sys_user ||--o{ sys_user_role
sys_role ||--o{ sys_user_role
sys_user ||--o| food_enterprise : 企业账号
sys_user ||--o| food_regulator : 监管账号

addr_region ||--o{ food_enterprise : 所属辖区
addr_region ||--o{ food_regulator_region : 管辖范围
food_regulator ||--o{ food_regulator_region

food_enterprise ||--o{ enterprise_profile_attachment
food_enterprise ||--o{ food_product

food_enterprise ||--o{ inspection_task
food_regulator ||--o{ inspection_task : 任务指派
inspection_task ||--o{ inspection_record
food_regulator ||--o{ inspection_record : 现场检查
inspection_record ||--o{ inspection_item
inspection_record ||--o| rectification_task : 一对一

food_enterprise ||--o{ sampling_task
food_product ||--o{ sampling_task
sampling_task ||--o| sampling_result : 一对一

food_enterprise ||--o{ complaint : 被投诉对象
complaint ||--o| complaint_handle : 一对一
food_regulator ||--o| complaint_handle : 办理反馈

warning_record ||--o{ warning_process_log

' ---------- 跨服务逻辑关联（无物理外键） ----------
sys_user ..> complaint : «逻辑»\n公众提交
addr_region ..> warning_record : «逻辑»\n辖区过滤
food_regulator ..> warning_record : «逻辑»\n责任/指派
food_enterprise ..> warning_record : «逻辑»\nbiz_type+biz_id

@enduml
