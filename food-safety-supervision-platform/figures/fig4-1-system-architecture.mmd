%% 图4-1 系统总体架构图
%% 用途：展示前端、网关、微服务、数据库及基础依赖之间的总体结构
flowchart LR
    subgraph Client["客户端"]
        Browser["浏览器"]
    end

    subgraph Frontend["前端层"]
        Web["food-web\nVue 3 + Vue Router 4 + Vite 5"]
    end

    subgraph Gateway["接入层"]
        GW["gateway-service\n统一路由 / JWT鉴权 / 跨域 / 限流"]
    end

    subgraph Services["业务服务层"]
        US["user-service\n注册 / 登录 / 内省 / 角色绑定"]
        RS["regulation-service\n企业备案 / 产品 / 监管人员 / 公告 / 文件 / 预警代理"]
        ROS["regulation-operation-service\n检查 / 抽检 / 整改 / outbox"]
        CS["complaint-service\n投诉提交 / 流转处理"]
        WS["warning-service\n预警记录 / 处理日志 / 统计"]
        QS["query-service\n监管概览 / 预警统计聚合"]
        PC["platform-common\n公共返回体与公共组件"]
    end

    subgraph Infra["基础依赖"]
        Nacos["Nacos\n注册发现 / 配置管理"]
        Redis["Redis\n会话 / 缓存 / 限流 / 锁"]
        MinIO["MinIO\n附件对象存储"]
    end

    subgraph Data["数据层"]
        UDB["用户库"]
        RDB["监管基础库"]
        ODB["监管操作库"]
        CDB["投诉库"]
        WDB["预警库"]
        QDB["查询扩展库"]
    end

    Browser --> Web --> GW
    GW --> US
    GW --> RS
    GW --> ROS
    GW --> CS
    GW --> QS

    US --> UDB
    RS --> RDB
    ROS --> ODB
    CS --> CDB
    WS --> WDB
    QS --> QDB

    US --- Nacos
    RS --- Nacos
    ROS --- Nacos
    CS --- Nacos
    WS --- Nacos
    QS --- Nacos
    GW --- Nacos

    US --- Redis
    RS --- Redis
    ROS --- Redis
    CS --- Redis
    WS --- Redis
    QS --- Redis
    GW --- Redis

    RS --- MinIO
    PC --- US
    PC --- RS
    PC --- ROS
    PC --- CS
    PC --- WS
    PC --- QS
