%% 图4-5 系统功能模块结构图
%% 用途：展示系统核心功能模块的纵向层次结构，适合论文竖向排版
flowchart TB
    Root["基于微服务的食品安全监管平台"]

    Root --> A["用户与认证模块"]
    Root --> B["企业备案与产品档案模块"]
    Root --> C["检查与抽检模块"]
    Root --> D["整改管理模块"]
    Root --> E["投诉处理模块"]
    Root --> F["公告公示与预警模块"]
    Root --> G["统计查询模块"]

    A --> A1["注册"]
    A --> A2["登录/登出"]
    A --> A3["令牌校验与角色控制"]

    B --> B1["备案提交与审核"]
    B --> B2["企业信息查询"]
    B --> B3["产品档案维护"]
    B --> B4["监管人员档案维护"]

    C --> C1["检查任务创建与分派"]
    C --> C2["检查结果提交"]
    C --> C3["抽检任务创建"]
    C --> C4["抽检结果录入与发布"]

    D --> D1["整改任务生成"]
    D --> D2["整改提交"]
    D --> D3["整改复核"]

    E --> E1["投诉提交与跟踪"]
    E --> E2["投诉受理与分派"]
    E --> E3["投诉反馈与驳回"]

    F --> F1["公告发布与下线"]
    F --> F2["公开查询"]
    F --> F3["预警访问与处理"]

    G --> G1["监管概览"]
    G --> G2["预警概览"]
    G --> G3["趋势/类型/效率"]

    classDef root fill:#eaf2ff,stroke:#3b6db3,stroke-width:2px,color:#1d2a3a,font-weight:bold;
    classDef module fill:#f8fafc,stroke:#7f8ea3,stroke-width:1.5px,color:#253041;
    classDef detail fill:#ffffff,stroke:#b8c2cc,stroke-width:1px,color:#374151;

    class Root root;
    class A,B,C,D,E,F,G module;
    class A1,A2,A3,B1,B2,B3,B4,C1,C2,C3,C4,D1,D2,D3,E1,E2,E3,F1,F2,F3,G1,G2,G3 detail;
