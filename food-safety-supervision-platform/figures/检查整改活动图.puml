@startuml
' 图名：检查整改活动图
' 用途：展示检查任务、结果提交、整改生成、企业整改与监管复核的主要活动流程
skinparam shadowing false
skinparam defaultFontName Microsoft YaHei
skinparam activity {
  BackgroundColor #ffffff
  BorderColor #6b7280
  DiamondBackgroundColor #f8fafc
  DiamondBorderColor #6b7280
  ArrowColor #6b7280
}

start
:区域管理员创建检查任务;
:分派执法人员;
:执法人员执行检查;
:提交检查结果与检查项;

if (是否存在不合格项?) then (是)
  :系统生成整改任务;
  :企业用户查看整改任务;
  :企业提交整改说明与附件;
  :区域管理员执行复核;
  if (复核通过?) then (是)
    :整改状态改为已确认;
  else (否)
    :整改状态改为退回整改;
    :企业重新提交整改;
    :区域管理员再次复核;
  endif
else (否)
  :检查任务完成;
endif

stop
@enduml
