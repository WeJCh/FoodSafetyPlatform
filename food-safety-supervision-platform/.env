# Docker compose template for the Food Safety Supervision Platform
# Edit these values before deployment.

TZ=Asia/Shanghai

# Public host / VM IP used by the browser.
PUBLIC_HOST=192.168.142.133

WEB_HOST_PORT=80
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379
NACOS_HOST_PORT=8848
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

MYSQL_ROOT_PASSWORD=123456
DB_USER=root
DB_PASSWORD=123456

REDIS_PASSWORD=123456
REDIS_DATABASE=0

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=complaints
MINIO_ENDPOINT=http://192.168.142.133:9000
MINIO_PUBLIC_ENDPOINT=http://192.168.142.133:9000

REGULATION_INTERNAL_TOKEN=regulation-internal-token
WARNING_INTERNAL_TOKEN=warning-internal-token
PLATFORM_REDIS_KEY_PREFIX=fsp
PLATFORM_REDIS_ENV=prod

# Browser-side API base. Keep the host aligned with PUBLIC_HOST.
VITE_API_BASE=http://192.168.142.133
VITE_REG_API_BASE=http://192.168.142.133
VITE_COMPLAINT_API_BASE=http://192.168.142.133

# Low-memory JVM defaults for a 1C / 1.8G demo VM.
JAVA_OPTS_USER=-Xms96m -Xmx192m -XX:+UseSerialGC -XX:MaxMetaspaceSize=128m -Djava.security.egd=file:/dev/./urandom
JAVA_OPTS_REGULATION=-Xms128m -Xmx224m -XX:+UseSerialGC -XX:MaxMetaspaceSize=128m -Djava.security.egd=file:/dev/./urandom
JAVA_OPTS_OPERATION=-Xms128m -Xmx224m -XX:+UseSerialGC -XX:MaxMetaspaceSize=128m -Djava.security.egd=file:/dev/./urandom
JAVA_OPTS_COMPLAINT=-Xms96m -Xmx160m -XX:+UseSerialGC -XX:MaxMetaspaceSize=128m -Djava.security.egd=file:/dev/./urandom
JAVA_OPTS_WARNING=-Xms96m -Xmx160m -XX:+UseSerialGC -XX:MaxMetaspaceSize=128m -Djava.security.egd=file:/dev/./urandom
JAVA_OPTS_QUERY=-Xms96m -Xmx160m -XX:+UseSerialGC -XX:MaxMetaspaceSize=128m -Djava.security.egd=file:/dev/./urandom
JAVA_OPTS_GATEWAY=-Xms96m -Xmx160m -XX:+UseSerialGC -XX:MaxMetaspaceSize=128m -Djava.security.egd=file:/dev/./urandom

# Nacos is memory-sensitive; keep it conservative on low-spec VMs.
NACOS_JVM_XMS=256m
NACOS_JVM_XMX=256m
NACOS_JVM_XMN=128m
