@startuml
' 图名：顶层用例图
' 用途：展示系统功能需求的总体划分，采用角色归类方式减少交叉连线
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam defaultFontName Microsoft YaHei
skinparam rectangle {
  BorderColor #6b7280
  BackgroundColor #ffffff
}
skinparam package {
  BorderColor #9ca3af
  BackgroundColor #f8fafc
}
skinparam usecase {
  BorderColor #6b7280
  BackgroundColor #ffffff
  ArrowColor #6b7280
}

actor "系统管理员" as Admin
actor "监管人员" as Regulator
actor "区域管理员" as RegAdmin
actor "执法人员" as Enforcer
actor "企业用户" as Enterprise
actor "公众用户" as Public

RegAdmin --|> Regulator
Enforcer --|> Regulator

rectangle "基于微服务的食品安全监管平台" {
  package "基础能力" {
    usecase "用户与认证" as UC1
  }

  package "监管端功能" {
    usecase "系统管理员管理" as UC2
    usecase "企业备案与产品档案" as UC3
    usecase "检查与整改" as UC4
    usecase "抽检与公示" as UC5
    usecase "投诉处理" as UC6
    usecase "公告、预警与统计" as UC7
  }
}

Admin --> UC1
Admin --> UC2

Regulator --> UC1
Regulator --> UC3
Regulator --> UC4
Regulator --> UC5
Regulator --> UC6
Regulator --> UC7

Enterprise --> UC1
Enterprise --> UC3
Enterprise --> UC4

Public --> UC1
Public --> UC5
Public --> UC6
Public --> UC7

@enduml
